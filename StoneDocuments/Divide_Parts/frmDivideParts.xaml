<Window x:Class="StoneDocuments.frmDivideParts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoneDocuments"
        mc:Ignorable="d"
        Title="Divide Parts"
        Height="330"
        Width="420"
        MinWidth="400"
        MinHeight="310"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="StyledButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="8"
            BorderBrush="#9CA3AF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="#2B5A8E"
                    CornerRadius="8,8,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Divide Parts"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                    <Button Content="×"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            Foreground="White"
                            Cursor="Hand"
                            Click="btnCancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Margin="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gap -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Division Gap" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <ComboBox x:Name="cmbGap" Grid.Row="0" Grid.Column="1" Height="24" FontSize="11" IsEditable="True" Text="1/8&quot;" Margin="0,0,0,12">
                        <ComboBoxItem Content="1/8&quot;"/>
                        <ComboBoxItem Content="3/16&quot;"/>
                        <ComboBoxItem Content="1/4&quot;"/>
                    </ComboBox>

                    <!-- Horizontal RP Type -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Horizontal Division RP Type" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <ComboBox x:Name="cmbHorizontal" Grid.Row="1" Grid.Column="1" Height="24" FontSize="11" Margin="0,0,0,12"/>

                    <!-- Vertical RP Type -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Vertical Division RP Type" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <ComboBox x:Name="cmbVertical" Grid.Row="2" Grid.Column="1" Height="24" FontSize="11" Margin="0,0,0,12"/>

                    <!-- Wall Selection -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="btnSelect"
                                Width="100"
                                Height="25"
                                Content="Select Walls..."
                                Click="btnSelect_Click"
                                Style="{StaticResource StyledButton}"/>
                        <TextBlock x:Name="tbkWallCount"
                                   Text="0 walls selected"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="btnCreate"
                                Width="100"
                                Height="25"
                                Content="Create Parts"
                                Click="btnCreate_Click"
                                Style="{StaticResource StyledButton}"/>
                        <Button x:Name="btnHelp"
                                Width="100"
                                Height="25"
                                Margin="10,0,0,0"
                                Content="Help"
                                Click="btnHelp_Click"
                                Style="{StaticResource StyledButton}"/>
                        <Button x:Name="btnCancel"
                                Width="100"
                                Height="25"
                                Margin="10,0,0,0"
                                Content="Cancel"
                                Click="btnCancel_Click"
                                Style="{StaticResource StyledButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
